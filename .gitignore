.coverage
htmlcov/

# Local application state (never commit runtime databases or logs)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
logs/
*.log

# Secrets — must never be committed
.env
.env.*
*.pem
*.key
secrets.json
credentials.json

# Editors / OS
.idea/
.vscode/
*.code-workspace
Thumbs.db
desktop.ini
